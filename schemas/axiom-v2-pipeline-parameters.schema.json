{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact_path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$",
      "minLength": 1
    },
    "sbom_path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$",
      "minLength": 1
    },
    "vulnerability_scan_path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$",
      "minLength": 1
    },
    "signature_path": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "governance_mode": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "max_allowed_severity": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "artifact_type": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "protected_branch": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "direct_push_allowed": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "review_required": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "branch_protection_status": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$"
    },
    "release_candidate": {
      "type": "boolean"
    }
  }
}
