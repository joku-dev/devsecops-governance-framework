{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Consistency Review Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_type",
    "repository",
    "reviewed_commit",
    "source_register_path",
    "source_register_sha256",
    "source_count",
    "source_documents",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_type": {"const": "document_consistency_review_source_manifest"},
    "repository": {"type": "string", "minLength": 1},
    "reviewed_commit": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
        {"type": "null"}
      ]
    },
    "source_register_path": {"const": "model/documents/source-document-register.yaml"},
    "source_register_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_count": {"type": "integer", "minimum": 1},
    "source_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "status",
          "version",
          "owner",
          "governance_domains",
          "source_path",
          "content_sha256"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "enum": ["candidate", "draft", "intake", "review", "approved", "superseded", "retired"]
          },
          "version": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "governance_domains": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_path": {
            "type": "string",
            "pattern": "^docs/governance/source-documents/[^/].*"
          },
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
