{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Consistency Semantic Evaluation Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "status", "source_manifest_sha256", "source_ids", "cases", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {"type": "string", "pattern": "^dcr-eval-catalog-[0-9]{4}$"},
    "status": {"const": "synthetic_only"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "expectation", "category", "required_evidence", "rationale"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^DCR-EVAL-[0-9]{3}$"},
          "expectation": {"enum": ["must_detect", "must_not_detect"]},
          "category": {"enum": ["conflict", "coverage_gap", "terminology", "duplicate_definition", "relationship_coverage"]},
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "locator"],
              "properties": {
                "source_id": {"type": "string"},
                "locator": {"type": "string"}
              }
            }
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
