{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_digest",
    "reviews",
    "validations"
  ],
  "properties": {
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role_id",
          "status",
          "execution_kind",
          "executor",
          "provider",
          "model",
          "summary",
          "outputs",
          "reviewed_paths",
          "reviewed_roles",
          "findings"
        ],
        "properties": {
          "role_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "failed",
              "skipped"
            ]
          },
          "execution_kind": {
            "enum": [
              "role_lens",
              "subagent",
              "human"
            ]
          },
          "executor": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "summary": {
            "type": "string"
          },
          "outputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "reviewed_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "reviewed_roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "severity",
                "path",
                "issue",
                "status"
              ],
              "properties": {
                "severity": {
                  "enum": [
                    "low",
                    "medium",
                    "high",
                    "critical"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "issue": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "open",
                    "resolved"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
