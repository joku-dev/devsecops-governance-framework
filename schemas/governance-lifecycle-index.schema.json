{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joku-dev.github.io/devsecops-governance-framework/schemas/governance-lifecycle-index.schema.json",
  "title": "Synthetic Lifecycle Finding Projection",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "index_type": {
      "const": "governance-lifecycle-synthetic"
    },
    "environment": {
      "const": "synthetic"
    },
    "official_state": {
      "const": false
    },
    "enforcement": {
      "const": "report_only"
    },
    "as_of": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/timestamp"
    },
    "profile_ref": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/versioned_ref"
    },
    "ledger_head_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^transaction:[a-f0-9]{64}$"
            },
            "digest": {
              "$ref": "governance-lifecycle-common.schema.json#/$defs/digest"
            }
          },
          "required": [
            "id",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "transactions": {
          "type": "integer",
          "minimum": 0
        },
        "observations": {
          "type": "integer",
          "minimum": 0
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "conflicts": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "transactions",
        "observations",
        "events",
        "conflicts",
        "findings"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^finding:[a-f0-9]{64}$"
          },
          "identity": {
            "$ref": "governance-lifecycle-common.schema.json#/$defs/finding"
          },
          "state": {
            "enum": [
              "open",
              "needs_clarification"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "occurrences": {
            "type": "integer",
            "minimum": 1
          },
          "first_failure_ref": {
            "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
          },
          "latest_observation_ref": {
            "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
          },
          "last_event_ref": {
            "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
          },
          "evidence_status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "observation_refs": {
            "type": "array",
            "items": {
              "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
            },
            "uniqueItems": true
          },
          "conflict_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^transaction:[a-f0-9]{64}$"
                },
                "digest": {
                  "$ref": "governance-lifecycle-common.schema.json#/$defs/digest"
                }
              },
              "required": [
                "id",
                "digest"
              ],
              "additionalProperties": false
            },
            "uniqueItems": true
          },
          "closure_supported": {
            "const": false
          }
        },
        "required": [
          "finding_id",
          "identity",
          "state",
          "revision",
          "occurrences",
          "first_failure_ref",
          "latest_observation_ref",
          "last_event_ref",
          "evidence_status",
          "observation_refs",
          "conflict_refs",
          "closure_supported"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "conflict_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^transaction:[a-f0-9]{64}$"
          },
          "digest": {
            "$ref": "governance-lifecycle-common.schema.json#/$defs/digest"
          }
        },
        "required": [
          "id",
          "digest"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "index_type",
    "environment",
    "official_state",
    "enforcement",
    "as_of",
    "profile_ref",
    "ledger_head_ref",
    "counts",
    "findings",
    "conflict_refs"
  ],
  "additionalProperties": false
}
