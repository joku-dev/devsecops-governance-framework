{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typed Evidence Results Index",
  "type": "object",
  "required": ["schema_version", "generated_at", "summary", "repositories"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": [
        "repository_count",
        "result_count",
        "mainline_results",
        "branch_results",
        "manual_results",
        "freshness_failures",
        "trust_level_counts",
        "evidence_type_counts"
      ],
      "properties": {
        "repository_count": { "type": "integer", "minimum": 0 },
        "result_count": { "type": "integer", "minimum": 0 },
        "mainline_results": { "type": "integer", "minimum": 0 },
        "branch_results": { "type": "integer", "minimum": 0 },
        "manual_results": { "type": "integer", "minimum": 0 },
        "freshness_failures": { "type": "integer", "minimum": 0 },
        "replay_failures": { "type": "integer", "minimum": 0 },
        "trust_level_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "evidence_type_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repository_id", "results_path", "latest_result", "latest_results", "history"],
        "properties": {
          "repository_id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "results_path": { "type": "string", "minLength": 1 },
          "latest_result": { "$ref": "#/$defs/resultProjection" },
          "latest_results": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/resultProjection" }
          },
          "history": {
            "type": "array",
            "items": { "$ref": "#/$defs/resultProjection" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "trustProjection": {
      "type": "object",
      "required": ["effective_level", "assessment_status", "verified_at", "check_summary"],
      "properties": {
        "effective_level": { "enum": ["unverified", "integrity_verified", "provenance_verified", "attested"] },
        "assessment_status": { "enum": ["not_available", "not_evaluated", "evaluated"] },
        "verified_at": { "type": ["string", "null"] },
        "replay": { "enum": ["pass", "fail", "not_evaluated"] },
        "check_summary": {
          "type": "object",
          "required": ["pass", "fail", "not_evaluated"],
          "properties": {
            "pass": { "type": "integer", "minimum": 0 },
            "fail": { "type": "integer", "minimum": 0 },
            "not_evaluated": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "resultProjection": {
      "type": "object",
      "required": [
        "generated_at",
        "evidence_type",
        "pipeline_run_id",
        "pipeline_event",
        "pipeline_url",
        "branch",
        "commit_id",
        "collector_status",
        "enforcement",
        "producer",
        "subject_binding",
        "freshness",
        "content_integrity",
        "trust",
        "source_file"
      ],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "evidence_type": { "enum": ["vulnerability_scan", "sbom"] },
        "pipeline_run_id": { "type": "string", "minLength": 1 },
        "pipeline_event": { "type": "string", "minLength": 1 },
        "pipeline_url": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit_id": { "type": "string", "minLength": 1 },
        "collector_status": { "enum": ["collected", "partial", "failed", "unknown"] },
        "enforcement": { "const": "report_only" },
        "producer": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "finding_count": { "type": "integer", "minimum": 0 },
        "max_severity": { "enum": ["none", "unknown", "info", "low", "medium", "high", "critical"] },
        "severity_consistent": { "type": "boolean" },
        "subject_binding": {
          "type": "object",
          "required": ["mode", "producer_attested"],
          "properties": {
            "mode": { "enum": ["co_collected", "scanner_attested", "unknown"] },
            "producer_attested": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "freshness": { "enum": ["pass", "fail", "not_evaluated"] },
        "content_integrity": { "enum": ["pass", "fail", "not_evaluated"] },
        "replay": { "enum": ["pass", "fail", "not_evaluated"] },
        "trust": { "$ref": "#/$defs/trustProjection" },
        "format": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "CycloneDX" },
            "version": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "component_count": { "type": "integer", "minimum": 1 },
        "container_images": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "service",
              "image_id",
              "artifact_id",
              "artifact_name",
              "artifact_archive_sha256",
              "archive_sha256",
              "archive_digest_verified",
              "image_layers_verified"
            ],
            "properties": {
              "service": {
                "enum": [
                  "ha-sync",
                  "query-api",
                  "neo4j",
                  "semantic-enrichment",
                  "world-model-chat"
                ]
              },
              "image_id": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "artifact_id": {
                "type": "string",
                "pattern": "^[0-9]+$"
              },
              "artifact_name": {
                "type": "string",
                "pattern": "^l1-image-"
              },
              "artifact_archive_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "archive_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "archive_digest_verified": {
                "const": true
              },
              "image_layers_verified": {
                "type": "integer",
                "minimum": 1
              },
              "sbom_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "sbom_digest_verified": {
                "const": true
              },
              "component_count": {
                "type": "integer",
                "minimum": 1
              },
              "counts": {
                "type": "object",
                "required": [
                  "CRITICAL",
                  "HIGH",
                  "MEDIUM",
                  "LOW",
                  "INFO",
                  "UNKNOWN"
                ],
                "properties": {
                  "CRITICAL": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "HIGH": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "MEDIUM": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "LOW": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "INFO": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "UNKNOWN": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "source_file": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence_type": { "const": "vulnerability_scan" } } },
          "then": {
            "required": ["finding_count", "max_severity", "severity_consistent"],
            "properties": {
              "container_images": {
                "items": { "required": ["counts"] }
              }
            }
          }
        },
        {
          "if": { "properties": { "evidence_type": { "const": "sbom" } } },
          "then": {
            "required": ["format", "component_count"],
            "properties": {
              "container_images": {
                "items": { "required": ["sbom_sha256", "sbom_digest_verified", "component_count"] }
              }
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
