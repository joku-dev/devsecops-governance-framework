{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "head_commit",
    "target_commit",
    "merge_base_commit",
    "changed_paths",
    "target",
    "proposed"
  ],
  "properties": {
    "head_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "target_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "merge_base_commit": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "changed_paths": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "validations"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(?:-[a-z]+)*$"
          }
        },
        "validations": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "proposed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "validations"
      ],
      "properties": {
        "roles": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+(?:-[a-z]+)*$"
          }
        },
        "validations": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    }
  }
}
