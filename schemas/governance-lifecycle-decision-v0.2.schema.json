{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joku-dev.github.io/devsecops-governance-framework/schemas/governance-lifecycle-decision-v0.2.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "environment",
    "profile_ref",
    "finding",
    "recorded_at",
    "body",
    "approval"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "record_type": {
      "const": "decision"
    },
    "record_id": {
      "type": "string",
      "pattern": "^decision:[a-zA-Z0-9._-]+$"
    },
    "environment": {
      "const": "synthetic"
    },
    "profile_ref": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/versioned_ref"
    },
    "finding": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/finding"
    },
    "recorded_at": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "required": [
        "expected_revision",
        "purpose",
        "observation_ref",
        "action",
        "rationale",
        "remediation_plan"
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "purpose": {
          "const": "remediate"
        },
        "observation_ref": {
          "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "supersedes_ref": {
          "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
        },
        "remediation_plan": {
          "type": "object",
          "properties": {
            "remediation_id": {
              "type": "string",
              "pattern": "^remediation-case:[a-zA-Z0-9._-]+$"
            },
            "owner_id": {
              "type": "string",
              "pattern": "^test-human:[a-zA-Z0-9._-]+$"
            },
            "target_at": {
              "$ref": "governance-lifecycle-common.schema.json#/$defs/timestamp"
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "work_ref": {
              "$ref": "governance-lifecycle-common.schema.json#/$defs/resource_ref"
            }
          },
          "required": [
            "remediation_id",
            "owner_id",
            "target_at",
            "action",
            "work_ref"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approval": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/approval"
    }
  },
  "additionalProperties": false,
  "title": "Governance Lifecycle Bound Remediation Decision 0.2.0",
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "synthetic"
          }
        }
      },
      "then": {
        "properties": {
          "approval": {
            "properties": {
              "channel": {
                "const": "synthetic_fixture"
              },
              "subject_id": {
                "type": "string",
                "pattern": "^test-human:[a-zA-Z0-9._-]+$"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "approval": {
            "properties": {
              "channel": {
                "const": "external_review"
              },
              "subject_id": {
                "not": {
                  "type": "string",
                  "pattern": "^test-human:"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": {
            "properties": {
              "disposition": {
                "const": "revoke"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "required": [
              "supersedes_ref"
            ]
          }
        }
      }
    }
  ]
}
