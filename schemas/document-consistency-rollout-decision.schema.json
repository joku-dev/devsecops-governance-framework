{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Consistency Rollout Decision",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "decision_id", "status", "basis", "required_before_decision", "prohibited_claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "decision_id": {"type": "string", "pattern": "^dcr-rollout-[0-9]{4}$"},
    "status": {"const": "pending"},
    "basis": {"const": "infrastructure_only"},
    "required_before_decision": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "prohibited_claims": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
