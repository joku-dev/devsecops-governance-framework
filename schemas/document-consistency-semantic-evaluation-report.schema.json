{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Consistency Semantic Evaluation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_type", "catalog_id", "review_id", "status", "scope_match", "summary", "cases", "limitations"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_type": {"const": "document_consistency_semantic_evaluation_report"},
    "catalog_id": {"type": "string"},
    "review_id": {"type": "string"},
    "status": {"enum": ["pass", "fail", "not_applicable"]},
    "scope_match": {"type": "boolean"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_count", "passed", "failed", "required_detected", "required_total", "prohibited_triggered", "eligible_finding_count"],
      "properties": {
        "case_count": {"type": "integer", "minimum": 0},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "required_detected": {"type": "integer", "minimum": 0},
        "required_total": {"type": "integer", "minimum": 0},
        "prohibited_triggered": {"type": "integer", "minimum": 0},
        "eligible_finding_count": {"type": "integer", "minimum": 0}
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "expectation", "result", "matching_finding_ids"],
        "properties": {
          "case_id": {"type": "string"},
          "expectation": {"enum": ["must_detect", "must_not_detect"]},
          "result": {"enum": ["pass", "fail", "not_applicable"]},
          "matching_finding_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
