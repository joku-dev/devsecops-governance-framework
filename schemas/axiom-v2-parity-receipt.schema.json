{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Declared technical functional-parity receipt metadata; no authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "kind",
    "passed",
    "runtime_source_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_./-]+$"
    },
    "kind": {
      "enum": [
        "positive",
        "negative",
        "installed",
        "comparison",
        "operating"
      ]
    },
    "passed": {
      "const": true
    },
    "runtime_source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_kind": {
      "const": "declared_technical_parity_evidence"
    },
    "v1_reference": {
      "const": "6b557fefe295b58272d2271326576ca3a3687197"
    },
    "original_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "implementation_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observed_source_revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "observed_source_tree": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "authority_transferred": {
      "const": false
    },
    "independent_human_approval": {
