{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Governance Release Signing Policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_id",
    "repository_id",
    "status",
    "enforcement",
    "direct_signature",
    "legacy_attestation",
    "cutover"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "policy_id": { "const": "governance-release-signing" },
    "repository_id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "status": { "const": "active_report_only" },
    "enforcement": { "const": "report_only" },
    "direct_signature": {
      "type": "object",
      "required": ["namespace", "trusted_signers"],
      "properties": {
        "namespace": { "const": "git" },
        "trusted_signers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "principal",
              "github_login",
              "key_type",
              "public_key",
              "fingerprint",
              "status",
              "valid_from"
            ],
            "properties": {
              "principal": { "type": "string", "minLength": 1 },
              "github_login": { "type": "string", "minLength": 1 },
              "key_type": { "const": "ssh-ed25519" },
              "public_key": { "type": "string", "pattern": "^ssh-ed25519 [A-Za-z0-9+/=]+$" },
              "fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]+$" },
              "status": { "const": "active" },
              "valid_from": { "type": "string", "format": "date-time" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "legacy_attestation": {
      "type": "object",
      "required": ["namespace", "manifest", "signature", "permitted_unsigned_tags"],
      "properties": {
        "namespace": { "const": "governance-release-integrity-v1" },
        "manifest": { "type": "string", "pattern": "^releases/[A-Za-z0-9._/-]+\\.json$" },
        "signature": { "type": "string", "pattern": "^releases/[A-Za-z0-9._/-]+\\.sig$" },
        "permitted_unsigned_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$" }
        }
      },
      "additionalProperties": false
    },
    "cutover": {
      "type": "object",
      "required": ["future_tags_require_direct_signature", "allow_new_legacy_tags"],
      "properties": {
        "future_tags_require_direct_signature": { "const": true },
        "allow_new_legacy_tags": { "const": false }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
