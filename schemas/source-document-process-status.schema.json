{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Document Process Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "generated_at", "report_type", "source_of_truth",
    "summary", "phases", "source_extraction", "consistency_review",
    "requirement_lifecycle", "authorized_source_baseline", "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "report_type": {"const": "source_document_process_status"},
    "source_of_truth": {"type": "object", "additionalProperties": {"type": "string"}},
    "summary": {
      "type": "object",
      "required": [
        "registered_sources", "authorized_sources", "source_status_counts",
        "requirement_identification_counts", "authorized_source_requirement_identification_counts", "lifecycle", "inferred_candidate_count",
        "consistency_findings_open", "effective_requirement_artifact_links", "baseline_status"
      ],
      "properties": {
        "registered_sources": {"type": "integer", "minimum": 0},
        "authorized_sources": {"type": "integer", "minimum": 0},
        "source_status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "requirement_identification_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "authorized_source_requirement_identification_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "lifecycle": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "inferred_candidate_count": {"type": "integer", "minimum": 0},
        "consistency_findings_open": {"type": "integer", "minimum": 0},
        "effective_requirement_artifact_links": {"type": "integer", "minimum": 0},
        "baseline_status": {"enum": ["blocked", "ready_for_human_approval"]}
      },
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "counts", "next_action"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "counts": {"type": "object", "additionalProperties": {"type": ["integer", "number", "string", "null"]}},
          "next_action": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "source_extraction": {
      "type": "object",
      "required": ["scanned_sources", "skipped_sources", "extraction_errors", "missing_source_ids", "unregistered_source_paths"],
      "properties": {
        "scanned_sources": {"type": "integer", "minimum": 0},
        "skipped_sources": {"type": "array"},
        "extraction_errors": {"type": "array"},
        "missing_source_ids": {"type": "array", "items": {"type": "string"}},
        "unregistered_source_paths": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "consistency_review": {
      "type": "object",
      "required": [
        "review_id", "status", "freshness", "scope_source_count",
        "scope_source_ids_available", "semantic_review_status",
        "semantic_item_coverage_status", "findings", "rollout_readiness", "production_rollout"
      ],
      "properties": {
        "review_id": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "freshness": {"type": "string"},
        "scope_source_count": {"type": "integer", "minimum": 0},
        "scope_source_ids_available": {"type": "boolean"},
        "semantic_review_status": {"type": "string"},
        "semantic_item_coverage_status": {"type": "string"},
        "findings": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "rollout_readiness": {"type": "string"},
        "production_rollout": {"type": "string"}
      },
      "additionalProperties": false
    },
    "requirement_lifecycle": {
      "type": "object",
      "required": ["summary", "missing_case_source_ids", "case_errors"],
      "properties": {
        "summary": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "missing_case_source_ids": {"type": "array", "items": {"type": "string"}},
        "case_errors": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authorized_source_baseline": {
      "type": "object",
      "required": [
        "status", "authorized_source_count", "authorized_source_set_sha256",
        "sources", "blocking_reasons", "consistency_review_id",
        "consistency_review_status", "unresolved_finding_count", "final_source_baseline_approval"
      ],
      "properties": {
        "status": {"enum": ["blocked", "ready_for_human_approval"]},
        "authorized_source_count": {"type": "integer", "minimum": 0},
        "authorized_source_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "version", "path", "status", "sha256"],
            "properties": {
              "source_id": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "path": {"type": "string"},
              "status": {"const": "approved"},
              "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$|^$"}
            },
            "additionalProperties": false
          }
        },
        "blocking_reasons": {"type": "array", "items": {"type": "string"}},
        "consistency_review_id": {"type": ["string", "null"]},
        "consistency_review_status": {"type": "string"},
        "unresolved_finding_count": {"type": "integer", "minimum": 0},
        "final_source_baseline_approval": {"enum": ["not_recorded", "approved"]}
      },
      "additionalProperties": false
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
