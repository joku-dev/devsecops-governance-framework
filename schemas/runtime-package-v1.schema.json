{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact-source prepared AXIOM runtime package v1 candidate",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "source_commit", "source_tree", "target", "files", "locks", "opa", "prepared_dependencies"],
  "properties": {
    "schema_version": {"const": 1},
    "source_commit": {"$ref": "#/$defs/git"}, "source_tree": {"$ref": "#/$defs/git"},
    "target": {"type": "object", "additionalProperties": false, "required": ["system", "machine"],
      "properties": {"system": {"enum": ["Darwin", "Linux"]}, "machine": {"enum": ["arm64", "aarch64", "x86_64"]}}},
    "files": {"type": "array", "minItems": 1, "maxItems": 19999, "items": {
      "type": "object", "additionalProperties": false, "required": ["path", "mode", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "mode": {"enum": ["100644", "100755"]},
        "size": {"type": "integer", "minimum": 0, "maximum": 268435456},
        "sha256": {"$ref": "#/$defs/digest"}, "git_blob": {"$ref": "#/$defs/git"}
      }
    }},
    "locks": {"enum": [["requirements-validation.lock"], ["requirements-validation.lock", "requirements-source-document-intake.lock"]]},
    "prepared_dependencies": {"type": "boolean"},
    "opa": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false,
      "required": ["asset", "version", "sha256"], "properties": {
        "asset": {"type": "string", "minLength": 1}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"$ref": "#/$defs/digest"}
      }}]}
  },
  "$defs": {"git": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
