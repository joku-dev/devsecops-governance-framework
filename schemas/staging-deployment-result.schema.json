{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/staging-deployment-result.schema.json",
  "title": "Verified staging deployment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result_type", "repository_id", "reference_baseline",
    "deployed_subject", "evidence_repository", "environment", "deployment",
    "approval", "components", "tests", "security_boundaries", "observations",
    "controls", "trust", "verified_sources", "verified_at", "source_file",
    "evidence_binding"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_type": {"const": "staging-deployment-result"},
    "repository_id": {"const": "joku-dev/ha-CPsWMS"},
    "reference_baseline": {"const": "l1-baseline-v1.1.3"},
    "deployed_subject": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "source_run_id", "source_attempt"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "source_run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "source_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "evidence_repository": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "path"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "path": {"type": "string", "pattern": "^deployment/staging/evidence/[A-Za-z0-9._-]+/$"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "hostname", "address"],
      "properties": {
        "name": {"const": "staging"},
        "hostname": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1}
      }
    },
    "deployment": {
      "type": "object", "additionalProperties": false,
      "required": ["started_at", "finished_at", "project", "status", "enforcement", "production_approval", "risk_acceptance", "compose_sha256", "api_binding"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "project": {"const": "ha-cpswms-staging"},
        "status": {"const": "pass"},
        "enforcement": {"const": "report-only"},
        "production_approval": {"const": false},
        "risk_acceptance": {"const": false},
        "compose_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "api_binding": {"const": "127.0.0.1:18080"}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "approved_at", "scope", "critical_findings_acknowledged", "high_findings_acknowledged"],
      "properties": {
        "decision": {"const": "approved_for_staging"},
        "approved_at": {"type": "string", "format": "date-time"},
        "scope": {"const": "staging_only"},
        "critical_findings_acknowledged": {"type": "integer", "minimum": 0},
        "high_findings_acknowledged": {"type": "integer", "minimum": 0}
      }
    },
    "components": {
      "type": "object", "additionalProperties": false,
      "required": ["query-api", "neo4j"],
      "properties": {
        "query-api": {"$ref": "#/$defs/component"},
        "neo4j": {"$ref": "#/$defs/component"}
      }
    },
    "tests": {
      "type": "object", "additionalProperties": false,
      "required": ["pass", "fail", "database_outage_http_status", "database_recovery_http_status"],
      "properties": {
        "pass": {"type": "integer", "minimum": 1},
        "fail": {"const": 0},
        "database_outage_http_status": {"type": "integer", "minimum": 400, "maximum": 599},
        "database_recovery_http_status": {"const": 200}
      }
    },
    "security_boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["query_api_non_root", "query_api_read_only_rootfs", "capabilities_dropped", "no_new_privileges", "api_loopback_only", "neo4j_not_published", "backend_network_internal"],
      "properties": {
        "query_api_non_root": {"const": true},
        "query_api_read_only_rootfs": {"const": true},
        "capabilities_dropped": {"const": true},
        "no_new_privileges": {"const": true},
        "api_loopback_only": {"const": true},
        "neo4j_not_published": {"const": true},
        "backend_network_internal": {"const": true}
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity", "id", "summary"],
        "properties": {
          "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
          "id": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    },
    "controls": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["control_id", "assessment", "observation", "remaining", "evidence_refs"],
        "properties": {
          "control_id": {"enum": ["DSCB-L1-REQ-013", "DSCB-L1-REQ-014", "DSCB-L1-REQ-016"]},
          "assessment": {"enum": ["measured", "partial"]},
          "observation": {"type": "string", "minLength": 1},
          "remaining": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "trust": {
      "type": "object", "additionalProperties": false,
      "required": ["effective_level", "assessment_status", "content_integrity", "freshness", "replay", "verified_at", "check_summary"],
      "properties": {
        "effective_level": {"const": "integrity_verified"},
        "assessment_status": {"const": "evaluated"},
        "content_integrity": {"const": "pass"},
        "freshness": {"const": "pass"},
        "replay": {"const": "pass"},
        "verified_at": {"type": "string", "format": "date-time"},
        "check_summary": {
          "type": "object", "additionalProperties": false,
          "required": ["pass", "fail", "not_evaluated"],
          "properties": {
            "pass": {"type": "integer", "minimum": 1},
            "fail": {"const": 0},
            "not_evaluated": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "verified_sources": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "verified_at": {"type": "string", "format": "date-time"},
    "source_file": {"type": "string", "pattern": "^status/staging-deployment-results/joku-dev__ha-CPsWMS/[A-Za-z0-9._-]+\\.json$"},
    "evidence_binding": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_image_id", "health"],
      "properties": {
        "runtime_image_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "health": {"const": "healthy"}
      }
    }
  }
}
