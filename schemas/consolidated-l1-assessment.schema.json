{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/consolidated-l1-assessment.schema.json",
  "title": "Consolidated measured and staging L1 assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_type",
    "profile",
    "repository_id",
    "reference_baseline",
    "run",
    "verified_at",
    "enforcement",
    "official_compliance_result",
    "production_approval",
    "risk_acceptance",
    "source_assessments",
    "controls",
    "summary",
    "evidence_binding"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "result_type": {
      "const": "consolidated-l1-assessment"
    },
    "profile": {
      "const": "ha-cpswms-l1-consolidated-v1"
    },
    "repository_id": {
      "const": "joku-dev/ha-CPsWMS"
    },
    "reference_baseline": {
      "const": "l1-baseline-v1.1.3"
    },
    "run": {
      "$ref": "#/$defs/run"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "enforcement": {
      "const": "report-only"
    },
    "official_compliance_result": {
      "const": false
    },
    "production_approval": {
      "const": false
    },
    "risk_acceptance": {
      "const": false
    },
    "source_assessments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "staging"
      ],
      "properties": {
        "measured": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_file",
            "profile",
            "evidence_binding"
          ],
          "properties": {
            "source_file": {
              "type": "string",
              "pattern": "^status/measured-l1-results/joku-dev__ha-CPsWMS/run-[1-9][0-9]*-attempt-[1-9][0-9]*\\.json$"
            },
            "profile": {
              "enum": [
                "ha-cpswms-l1-measured-v1",
                "ha-cpswms-l1-measured-v2"
              ]
            },
            "evidence_binding": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "staging": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_file",
            "evidence_binding",
            "effective_level",
            "freshness",
            "replay"
          ],
          "properties": {
            "source_file": {
              "type": "string",
              "pattern": "^status/staging-deployment-results/joku-dev__ha-CPsWMS/[A-Za-z0-9._-]+\\.json$"
            },
            "evidence_binding": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "effective_level": {
              "const": "integrity_verified"
            },
            "freshness": {
              "const": "pass"
            },
            "replay": {
              "const": "pass"
            }
          }
        }
      }
    },
    "controls": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/control"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "evidence_binding": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "attempt",
        "commit",
        "branch",
        "event",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "branch": {
          "const": "main"
        },
        "event": {
          "const": "push"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_id",
        "title",
        "assessment",
        "tools",
        "observation",
        "remaining",
        "evidence_refs"
      ],
      "properties": {
        "control_id": {
          "type": "string",
          "pattern": "^DSCB-L1-REQ-0(0[1-9]|1[0-6])$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "assessment": {
          "enum": [
            "measured",
            "partial",
            "findings",
            "gap"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "remaining": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measured",
        "partial",
        "findings",
        "gap"
      ],
      "properties": {
        "measured": {
          "type": "integer",
          "minimum": 0
        },
        "partial": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "gap": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
