{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git-native governance requirement source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "normative_strength", "domain", "owner", "decision_ref", "statement"],
  "properties": {
    "id": {"type": "string", "pattern": "^NATIVE-REQ-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "normative_strength": {"enum": ["MUST", "SHOULD", "MAY", "REQUIREMENT"]},
    "domain": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "decision_ref": {"type": "string", "pattern": "^docs/governance/change-requests/GCR-.+\\.md$"},
    "statement": {"type": "string", "minLength": 1}
  }
}
