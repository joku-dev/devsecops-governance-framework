{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement To Artifact Register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "register_id", "version", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "register_id": {"const": "REQUIREMENT-TO-ARTIFACT-REGISTER"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "requirement_ref", "source_requirement_refs", "artifact", "relationship", "decision", "enforcement"],
        "properties": {
          "id": {"type": "string", "pattern": "^RTA-[0-9]{6}$"},
          "requirement_ref": {"type": "string", "pattern": "^GRQ-[0-9]{6}@rev[1-9][0-9]*$"},
          "source_requirement_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "type", "artifact_id", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "type": {"enum": ["documentation", "controls", "platform", "architecture", "policies", "schemas", "workflows", "releases"]},
              "artifact_id": {"type": ["string", "null"]},
              "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          },
          "relationship": {"enum": ["adopts", "implements", "enforces", "supports", "publishes"]},
          "decision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "status", "decided_by", "decision_role", "decided_at", "decision_ref", "equivalence", "equivalence_evidence"],
            "properties": {
              "kind": {"enum": ["adoption", "derivation"]},
              "status": {"enum": ["approved", "effective", "rejected", "superseded"]},
              "decided_by": {"type": "string", "minLength": 1},
              "decision_role": {"type": "string", "minLength": 1},
              "decided_at": {"type": "string", "format": "date-time"},
              "decision_ref": {"type": "string", "minLength": 1},
              "equivalence": {"enum": ["equivalent", "partial", "not_equivalent"]},
              "equivalence_evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          },
          "enforcement": {"enum": ["none", "report_only", "blocking"]}
        }
      }
    }
  }
}
