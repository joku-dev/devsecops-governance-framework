{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Consistency Review Structural Model",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reviewed_commit",
    "sources",
    "roles",
    "local_role_profiles",
    "requirements",
    "gates",
    "artifacts",
    "evidence_links",
    "relationships",
    "derivation_relationships",
    "topic_authorities"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "reviewed_commit": {"type": ["string", "null"]},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "version", "source_path", "sha256", "identifiers"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "source_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "identifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "line", "kind"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "line": {"type": "integer", "minimum": 1},
                "kind": {"enum": ["declared", "reference"]}
              }
            }
          }
        }
      }
    },
    "roles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "local_role_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "mandatory", "owner_role_id", "verification_artifact_id", "open_gap"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "strength": {"enum": ["MUST", "SHALL", "REQUIREMENT"]},
          "mandatory": {"type": "boolean"},
          "owner_role_id": {"type": ["string", "null"]},
          "verification_artifact_id": {"type": ["string", "null"]},
          "open_gap": {"type": ["string", "null"]}
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "input_artifact_ids", "output_artifact_ids", "decision_owner_role_id", "open_gap"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "input_artifact_ids": {"type": "array", "items": {"type": "string"}},
          "output_artifact_ids": {"type": "array", "items": {"type": "string"}},
          "decision_owner_role_id": {"type": ["string", "null"]},
          "open_gap": {"type": ["string", "null"]}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source_id", "kind"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_id", "artifact_id"],
        "properties": {
          "requirement_id": {"type": "string", "minLength": 1},
          "artifact_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "source_entity_id", "target_entity_id", "source_document_id", "status"],
        "properties": {
          "type": {"enum": ["defines", "references", "implements", "verified_by", "evidenced_by", "owned_by", "depends_on"]},
          "source_entity_id": {"type": "string", "minLength": 1},
          "target_entity_id": {"type": "string", "minLength": 1},
          "source_document_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "confirmed"]}
        }
      }
    },
    "derivation_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "target_id", "status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "target_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["candidate", "accepted"]}
        }
      }
    },
    "topic_authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topic", "source_ids", "decision_open"],
        "properties": {
          "topic": {"type": "string", "minLength": 1},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "decision_open": {"type": "boolean"}
        }
      }
    }
  }
}
