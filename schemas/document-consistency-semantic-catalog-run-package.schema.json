{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Consistency Semantic Catalog Run Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_type", "package_id", "status", "provider_binding", "model_binding", "prompt_version", "adapter_configuration", "catalog", "provider_input", "decision_boundary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "package_type": {"const": "document_consistency_semantic_catalog_run_package"},
    "package_id": {"type": "string", "pattern": "^dcr-catalog-run-[0-9]{4}$"},
    "status": {"const": "prepared_not_run"},
    "provider_binding": {"const": "runtime_authorization_required"},
    "model_binding": {"const": "runtime_authorization_required"},
    "prompt_version": {"type": "string", "minLength": 1},
    "adapter_configuration": {"const": "dcr-adapter-0001"},
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"const": "dcr-eval-catalog-0001"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "provider_input": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "decision_boundary": {"type": "string", "minLength": 1}
  }
}
