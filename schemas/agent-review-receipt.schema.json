{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public agent review metadata receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "receipt_digest", "plan_digest", "results_digest", "head_commit", "base_commit", "changed_paths", "roles", "validations", "finding_counts", "eligible_for_human_review", "evidence_kind", "independent_human_approval", "recorded_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_id": {"$ref": "#/$defs/digest"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "plan_digest": {"$ref": "#/$defs/digest"},
    "results_digest": {"$ref": "#/$defs/digest"},
    "head_commit": {"$ref": "#/$defs/commit"},
    "base_commit": {"$ref": "#/$defs/commit"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "changed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "roles": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role_id", "status", "execution_kind", "execution_declared"],
        "properties": {
          "role_id": {"type": "string", "pattern": "^[a-z]+(?:-[a-z]+)*$"},
          "status": {"enum": ["pending", "completed", "failed", "skipped"]},
          "execution_kind": {"enum": ["role_lens", "subagent", "human"]},
          "execution_declared": {"type": "boolean"}
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["command", "status"],
        "properties": {"command": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "failed", "not_run"]}}
      }
    },
    "finding_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["open", "resolved"],
      "properties": {"open": {"$ref": "#/$defs/counts"}, "resolved": {"$ref": "#/$defs/counts"}}
    },
    "eligible_for_human_review": {"type": "boolean"},
    "evidence_kind": {"const": "self_reported_review_evidence"},
    "independent_human_approval": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["low", "medium", "high", "critical"],
      "properties": {
        "low": {"type": "integer", "minimum": 0}, "medium": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0}, "critical": {"type": "integer", "minimum": 0}
      }
    }
  }
}
