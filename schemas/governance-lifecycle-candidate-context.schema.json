{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joku-dev.github.io/devsecops-governance-framework/schemas/governance-lifecycle-candidate-context.schema.json",
  "type": "object",
  "properties": {
    "repository_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "run_attempt": {
      "type": "integer",
      "minimum": 1
    },
    "baseline_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "event": {
      "enum": [
        "push",
        "pull_request",
        "workflow_dispatch",
        "release"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "release_context": {
      "type": "boolean"
    },
    "synthetic": {
      "type": "boolean"
    },
    "observed_at": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/timestamp"
    },
    "report_sha256": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/digest"
    }
  },
  "required": [
    "repository_id",
    "branch",
    "commit_id",
    "producer_id",
    "run_id",
    "run_attempt",
    "baseline_ref",
    "policy_revision",
    "event",
    "purpose",
    "release_context",
    "synthetic",
    "observed_at",
    "report_sha256"
  ],
  "additionalProperties": false
}
