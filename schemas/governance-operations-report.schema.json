{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daily Governance Operations Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "repository", "checkout_sha", "main_head", "enforcement", "overall_status", "summary", "thresholds", "checks", "decision_boundary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 3},
    "checkout_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "main_head": {"type": ["string", "null"]},
    "enforcement": {"const": "report_only"},
    "overall_status": {"enum": ["ok", "attention", "unknown"]},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "attention", "unknown"],
      "properties": {
        "ok": {"type": "integer", "minimum": 0},
        "attention": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "evidence_max_age_days", "review_warning_hours", "run_warning_hours", "intake_failure_window_hours", "scheduled_workflows"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "evidence_max_age_days": {"type": "integer", "minimum": 1},
        "review_warning_hours": {"type": "integer", "minimum": 1},
        "run_warning_hours": {"type": "integer", "minimum": 1},
        "intake_failure_window_hours": {"type": "integer", "minimum": 1},
        "scheduled_workflows": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["category", "subject", "status", "detail", "action", "owner", "source_url"],
        "properties": {
          "category": {"enum": ["observation", "workflow", "intake", "evidence", "review", "security"]},
          "subject": {"type": "string", "minLength": 1},
          "status": {"enum": ["ok", "attention", "unknown"]},
          "detail": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "source_url": {"type": "string"}
        }
      }
    },
    "decision_boundary": {
      "type": "object", "additionalProperties": false,
      "required": ["changes_official_results", "approves_prs", "changes_enforcement"],
      "properties": {
        "changes_official_results": {"const": false},
        "approves_prs": {"const": false},
        "changes_enforcement": {"const": false}
      }
    }
  }
}
