{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private declared-association workspace context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "official_acceptance",
    "production_approval",
    "risk_acceptance",
    "authority_transferred",
    "operating_acceptance_inherited",
    "published",
    "agent_execution_verified",
    "human_approval_verified",
    "subject_authenticity_verified",
    "schema_version",
    "kind",
    "node_id",
    "runtime_source_digest",
    "source_revision",
    "rules_sha256",
    "source_input_id",
    "evidence_trust",
    "seed_record_paths"
  ],
  "properties": {
    "official_acceptance": {
      "const": false
    },
    "production_approval": {
      "const": false
    },
    "risk_acceptance": {
      "const": false
    },
    "authority_transferred": {
      "const": false
    },
    "operating_acceptance_inherited": {
      "const": false
    },
    "published": {
      "const": false
    },
    "agent_execution_verified": {
      "const": false
    },
    "human_approval_verified": {
      "const": false
    },
    "subject_authenticity_verified": {
      "const": false
    },
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "declared-evidence-agent-associations"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runtime_source_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "rules_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_input_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "evidence_trust": {
      "const": "unverified"
    },
    "seed_record_paths": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10000,
      "items": {
        "type": "string",
        "pattern": "^status/evidence-agent-provenance/.+\\.json$"
      }
    }
  }
}
