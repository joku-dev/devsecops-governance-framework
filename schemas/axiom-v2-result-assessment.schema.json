{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AXIOM V2 private result assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "node_id",
    "runtime_source_digest",
    "source_revision",
    "source_worktree_clean",
    "assessed_at",
    "input_origin",
    "input_id",
    "raw_manifest",
    "repository",
    "snapshots",
    "mode",
    "evidence_trust",
    "official_acceptance",
    "production_approval",
    "risk_acceptance",
    "authority_transferred",
    "storage_budget_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "v1-compatible-general-result-assessment"
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "runtime_source_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_worktree_clean": {
      "type": "boolean"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_origin": {
      "const": "operator_bundle"
    },
    "input_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "raw_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "input_kind",
        "metadata_sha256",
        "summary_sha256",
        "bundle"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "input_kind": {
          "enum": [
            "bundle",
            "manual"
          ]
        },
        "metadata_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "summary_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "bundle": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "input_sha256",
                "files",
                "raw_bytes",
                "material_bytes"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "directory",
                    "zip"
                  ]
                },
                "input_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "files": {
                  "type": "object",
                  "maxProperties": 4096,
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sha256",
                      "bytes"
                    ],
                    "properties": {
                      "sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{64}$"
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 268435456
                      }
                    }
                  }
                },
                "raw_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2147483648
                },
                "material_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1073741824
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "instance",
        "native_id",
        "path",
        "url"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "instance": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "native_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "snapshots": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "additionalProperties": false,
      "properties": {
        "devsecops": {
          "type": "object"
        },
        "architecture": {
          "type": "object"
        }
      }
    },
    "mode": {
      "const": "report-only"
    },
    "evidence_trust": {
      "const": "unverified"
    },
    "official_acceptance": {
      "const": false
    },
    "production_approval": {
      "const": false
    },
    "risk_acceptance": {
      "const": false
    },
    "authority_transferred": {
      "const": false
    },
    "storage_budget_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 34359738368
    }
  }
}
