{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Governance Requirement Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "next_sequence", "requirements"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "catalog_id": {"const": "GOVERNANCE-REQUIREMENT-CATALOG"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "next_sequence": {"type": "integer", "minimum": 1},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "active_revision", "revisions"],
        "properties": {
          "id": {"type": "string", "pattern": "^GRQ-[0-9]{6}$"},
          "active_revision": {"type": ["integer", "null"], "minimum": 1},
          "revisions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["revision", "status", "title", "statement", "normative_strength", "domain", "owner", "approved_at", "effective_from", "effective_until", "source_refs", "relationships", "decision_ref", "authorized_derivations", "runtime_enforcement"],
              "properties": {
                "revision": {"type": "integer", "minimum": 1},
                "status": {"enum": ["approved", "effective", "superseded", "retired"]},
                "title": {"type": "string", "minLength": 1},
                "statement": {"type": "string", "minLength": 1},
                "normative_strength": {"enum": ["MUST", "SHOULD", "MAY", "REQUIREMENT"]},
                "domain": {"type": "string", "minLength": 1},
                "owner": {"type": "string", "minLength": 1},
                "approved_at": {"type": "string", "format": "date-time"},
                "effective_from": {"type": "string", "format": "date"},
                "effective_until": {"type": ["string", "null"], "format": "date"},
                "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
                "relationships": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["type", "target"],
                    "properties": {
                      "type": {"enum": ["duplicates", "extends", "revises", "supersedes", "conflicts_with", "derived_from"]},
                      "target": {"type": "string", "minLength": 1}
                    }
                  }
                },
                "decision_ref": {"type": "string", "minLength": 1},
                "authorized_derivations": {"type": "array", "uniqueItems": true, "items": {"enum": ["documentation", "controls", "platform", "architecture", "policies", "schemas", "workflows", "releases"]}},
                "runtime_enforcement": {"enum": ["none", "report_only", "blocking"]}
              }
            }
          }
        }
      }
    }
  }
}
