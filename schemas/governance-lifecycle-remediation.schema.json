{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joku-dev.github.io/devsecops-governance-framework/schemas/governance-lifecycle-remediation.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "record_id",
    "environment",
    "profile_ref",
    "finding",
    "recorded_at",
    "body"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "remediation"
    },
    "record_id": {
      "type": "string",
      "pattern": "^remediation:[a-zA-Z0-9._-]+$"
    },
    "environment": {
      "enum": [
        "synthetic",
        "live"
      ]
    },
    "profile_ref": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/versioned_ref"
    },
    "finding": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/finding"
    },
    "recorded_at": {
      "$ref": "governance-lifecycle-common.schema.json#/$defs/timestamp"
    },
    "body": {
      "type": "object",
      "required": [
        "expected_revision",
        "decision_ref",
        "owner_id",
        "target_at",
        "action",
        "work_ref",
        "progress"
      ],
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "decision_ref": {
          "$ref": "governance-lifecycle-common.schema.json#/$defs/record_ref"
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*:[a-zA-Z0-9._-]+$"
        },
        "target_at": {
          "$ref": "governance-lifecycle-common.schema.json#/$defs/timestamp"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "work_ref": {
          "$ref": "governance-lifecycle-common.schema.json#/$defs/resource_ref"
        },
        "progress": {
          "enum": [
            "planned",
            "in_progress",
            "completed"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "Governance Lifecycle Remediation (pilot 0.1.0)",
  "allOf": [
    {
      "if": {
        "properties": {
          "environment": {
            "const": "synthetic"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "owner_id": {
                "pattern": "^test-human:[a-zA-Z0-9._-]+$"
              }
            }
          }
        }
      }
    }
  ]
}
