[Unit]
Description=AXIOM private single-maintainer Workbench
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User={{ vm_user }}
Group={{ vm_user }}
WorkingDirectory={{ vm_repo }}
EnvironmentFile={{ vm_environment }}
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart={{ vm_venv }}/bin/python {{ vm_repo }}/scripts/serve_governance_workbench.py --port {{ vm_port }}{% if vm_consumer_support.stat.exists %} --consumer-projection {{ vm_consumer_projection }}{% endif %}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
ReadWritePaths={{ vm_state }}

[Install]
WantedBy=multi-user.target
